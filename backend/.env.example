# BidPilot UAE backend configuration.
# Copy to `.env` and adjust. Every value is validated at startup; a bad value stops the
# process with a precise message instead of failing later at runtime.

# --- Application ---------------------------------------------------------------------
APP_ENV=development
APP_NAME=BidPilot UAE
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# Comma-separated CORS allowlist. Never a wildcard: refresh cookies require credentials.
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ------------------------------------------------------------------------
# The asyncpg driver is mandatory; a sync URL is rejected at startup.
# Port 55432 (not 5432) is what docker-compose.yml publishes, so the stack does not clash
# with another project's PostgreSQL already running on this machine.
DATABASE_URL=postgresql+asyncpg://bidpilot:bidpilot@localhost:55432/bidpilot

# --- Redis / worker ------------------------------------------------------------------
REDIS_URL=redis://localhost:56379/0

# --- Docker Compose host ports -------------------------------------------------------
# Read by docker-compose.yml only. Change these together with the URLs above.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379

# --- Authentication ------------------------------------------------------------------
# Minimum 32 characters. Placeholder values are refused unless APP_ENV=development.
# Also keys the HMAC that hashes client IPs before they are stored.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-value
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PASSWORD_MIN_LENGTH=12

# Refresh cookie. Leave the two commented values unset to derive them from APP_ENV:
# development gets SameSite=Lax over http; anything else gets SameSite=None + Secure,
# which is required when the API and frontend are on different domains.
REFRESH_COOKIE_NAME=bidpilot_refresh
# REFRESH_COOKIE_SECURE=true
# REFRESH_COOKIE_SAMESITE=none

# --- Company evidence ----------------------------------------------------------------
# How far ahead a certificate counts as "expiring soon". The state itself is always derived
# from dates and verification status, never stored.
EVIDENCE_EXPIRING_SOON_DAYS=60

# --- Rate limiting -------------------------------------------------------------------
# Fixed window per (account, hashed client IP). Fails open if Redis is unreachable.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
REGISTER_MAX_ATTEMPTS=5
REGISTER_WINDOW_SECONDS=3600

# --- Storage and uploads -------------------------------------------------------------
# local | s3   (the S3 adapter is added only when deployment requires it)
STORAGE_BACKEND=local
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=200

# --- OpenAI (Phase 6) ----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Anthropic (optional; enabled only after the OpenAI workflow works) --------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- AI behaviour and versioning -----------------------------------------------------
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
# Recorded on every analysis so a result can be reproduced and compared.
PROMPT_VERSION=1.0.0
SCORING_VERSION=1.0.0
