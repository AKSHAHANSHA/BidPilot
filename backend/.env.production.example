# BidPilot UAE — production environment template (backend).
#
# Copy the KEYS into your host's secret manager (Render/Railway dashboard). NEVER commit real
# values. Every secret below must be set as a secret, not a plain env var, where the host supports
# it. Placeholders here are illustrative only.

# --- Application -----------------------------------------------------------------------------
APP_ENV=production
APP_NAME=BidPilot UAE
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# Comma-separated allowlist. Must be the exact Vercel origin(s); never a wildcard (refresh
# cookies are used). Example: https://bidpilot.vercel.app
FRONTEND_ORIGIN=https://REPLACE-with-your-frontend.vercel.app

# --- Datastores (managed, TLS) ---------------------------------------------------------------
# Neon/Supabase give a postg:// URL — rewrite the scheme to postgresql+asyncpg:// and keep
# sslmode=require. Upstash gives a rediss:// URL (TLS). Both are SECRETS.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require
REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# --- Auth ------------------------------------------------------------------------------------
# 32+ random chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PASSWORD_MIN_LENGTH=12
REFRESH_COOKIE_NAME=bidpilot_refresh
# Frontend and backend are on different sites (vercel.app vs onrender.com), so the refresh
# cookie must be cross-site: SameSite=None AND Secure. Both are enforced together by config.
REFRESH_COOKIE_SAMESITE=none
REFRESH_COOKIE_SECURE=true

# --- Rate limits -----------------------------------------------------------------------------
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300
REGISTER_MAX_ATTEMPTS=5
REGISTER_WINDOW_SECONDS=3600

# --- Storage ---------------------------------------------------------------------------------
# Host disks are EPHEMERAL: uploads are lost on redeploy/restart. Acceptable for a demo (re-run
# `make demo-reset` and re-upload the sample). For durable uploads, add an S3-compatible backend.
STORAGE_BACKEND=local
UPLOAD_DIR=/tmp/bidpilot-uploads
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=200

# --- LLM (SECRET) ----------------------------------------------------------------------------
# Keep spend controlled. Anthropic fallback stays disabled (blank) by default.
OPENAI_API_KEY=REPLACE-with-your-openai-key
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# --- Versions --------------------------------------------------------------------------------
PROMPT_VERSION=1.0.0
SCORING_VERSION=1.0.0
