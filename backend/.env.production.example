# BidPilot UAE — production environment template (backend).
#
# Copy these KEYS into the Render dashboard as secrets. NEVER commit real values — this file ships
# placeholders only. See deploy/DEPLOYMENT.md for how to obtain each value (Supabase, Upstash).

# --- Application -----------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO

# --- Database (Supabase PostgreSQL, TLS) ----------------------------------------------------
# Use the async driver scheme. Supabase gives a postgres:// URL — rewrite it to
# postgresql+asyncpg:// and keep TLS. Prefer the POOLED (pgBouncer, port 6543) connection for the
# app runtime; see deploy/DEPLOYMENT.md for the migration/direct-connection note.
DATABASE_URL=

# --- Redis (Upstash, TLS) -------------------------------------------------------------------
# Upstash gives a rediss:// URL (TLS). Do not use Render Key Value.
REDIS_URL=

# --- Auth -----------------------------------------------------------------------------------
# 48+ random chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Frontend (Vercel) and backend (Render) are different sites, so the refresh cookie must be
# cross-site. These two are also set in render.yaml; keep them consistent.
REFRESH_COOKIE_SAMESITE=none
REFRESH_COOKIE_SECURE=true

# --- CORS -----------------------------------------------------------------------------------
# Exact Vercel origin(s), comma-separated. Never a wildcard (refresh cookies are used).
FRONTEND_ORIGIN=

# --- AI provider (OpenAI) -------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Storage (Supabase Storage via S3-compatible API) ---------------------------------------
# Server-side secrets only; never exposed to the frontend. Bucket must be PRIVATE.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
